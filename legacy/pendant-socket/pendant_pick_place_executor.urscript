# ===== 抓放执行器（示教器 Script 节点用）：电脑发 cycle 做一轮，回 done =====
# 电脑端: python3 ~/ur_learn/scripts/ur_pick_place_cycle.py [次数|--forever]
# 关键: socket_open 最前；rq_set_pos(0开/255闭)；movel 和 rq_* 都在示教器环境执行

status := socket_open("192.168.1.10", 30010, "g")
rq_activate()
sleep(1)

# 点位(字面量)
pkx := 0.6474
pky := -0.2685
pkz := 0.2761
plx := 0.6722
ply := 0.0368
plz := 0.2761
rx := 1.9351
ry := -2.3646
rz := -0.0002
h := 0.05
run := True
while run:
  cmd := socket_read_string("g")
  if cmd == "cycle":
    # 抓取
    movel(p[pkx, pky, pkz+h, rx, ry, rz], a=0.3, v=0.05)
    movel(p[pkx, pky, pkz, rx, ry, rz], a=0.3, v=0.05)
    sleep(0.3)
    rq_set_pos(255)
    sleep(0.8)
    movel(p[pkx, pky, pkz+h, rx, ry, rz], a=0.3, v=0.05)
    # 放置
    movel(p[plx, ply, plz+h, rx, ry, rz], a=0.3, v=0.05)
    movel(p[plx, ply, plz, rx, ry, rz], a=0.3, v=0.05)
    sleep(0.3)
    rq_set_pos(0)
    sleep(0.8)
    movel(p[plx, ply, plz+h, rx, ry, rz], a=0.3, v=0.05)
    socket_send_string("done", "g")
  elif cmd == "stop":
    run := False
    socket_send_string("stopped", "g")
  end
  sleep(0.1)
end
