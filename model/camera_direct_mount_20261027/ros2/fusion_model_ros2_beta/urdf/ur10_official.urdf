  <!-- base_joint fixes base_link to the environment -->
  <joint name="base_joint" type="fixed">
    <!-- UR10 pedestal is separated from the near table edge. -->
    <origin rpy="0 0 0" xyz="0 0 0.580"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="robot_pedestal_link">
    <visual>
      <geometry><cylinder radius="0.10" length="0.58"/></geometry>
      <material name="pedestal_gray"><color rgba="0.22 0.24 0.26 1"/></material>
    </visual>
  </link>
  <joint name="world-robot_pedestal" type="fixed">
    <origin xyz="0 0 0.290" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="robot_pedestal_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 -0.000056460204029449082" xyz="0 0 0.12825181172186206"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.5706719269899678 0 0.000015727956371942" xyz="0.000051805159516365 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="3.1382365514883417 3.1415661039055771 -3.1415384532606816" xyz="-0.6123833190672483 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="3.1391901330265317 -3.141519693345717 3.1415835322576635" xyz="-0.57143067297075534 0.0003930062332988286 0.16358048424247151"/>
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.5703602967415915 0 -0.000036642768429068" xyz="0.000024084619826572 -0.11568595442769607 0.000050442556072512"/>
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.5713337472486533 3.141592653589793 -3.1415839915094663" xyz="0.000029069810266962 0.092166082125499024 0.000049531942547077"/>
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <!-- Exact SolidWorks-exported rigid end-effector assembly from the real UR10
       repository.  CAD -Y maps to tool0 +Z and the operator-confirmed assembly
       clocking is 270 degrees.  All four meshes share this registration. -->
  <link name="cad_force_sensor_link">
    <visual><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_force_sensor.stl" scale="0.001 0.001 0.001"/></geometry><material name="ati_blue"><color rgba="0.10 0.35 0.75 1"/></material></visual>
    <collision><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_force_sensor.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="tool0-cad_force_sensor" type="fixed">
    <origin xyz="-0.080221162 0.327612370 0.238737610" rpy="-1.570796327 0 -1.570796327"/>
    <parent link="tool0"/><child link="cad_force_sensor_link"/>
  </joint>
  <link name="cad_connector_link">
    <visual><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_connector.stl" scale="0.001 0.001 0.001"/></geometry><material name="connector_gray"><color rgba="0.60 0.60 0.60 1"/></material></visual>
    <collision><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_connector.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="tool0-cad_connector" type="fixed">
    <origin xyz="-0.080221162 0.327612370 0.238737610" rpy="-1.570796327 0 -1.570796327"/>
    <parent link="tool0"/><child link="cad_connector_link"/>
  </joint>
  <link name="cad_robotiq_2f85_link">
    <visual><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_2f85_closed.stl" scale="0.001 0.001 0.001"/></geometry><material name="gripper_gray"><color rgba="0.18 0.20 0.23 1"/></material></visual>
    <collision><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_2f85_closed.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="tool0-cad_robotiq_2f85" type="fixed">
    <origin xyz="-0.080221162 0.327612370 0.238737610" rpy="-1.570796327 0 -1.570796327"/>
    <parent link="tool0"/><child link="cad_robotiq_2f85_link"/>
  </joint>
  <!-- Photo-based direct camera mount: horizontal long edge, broad side
       against connector, top flush with camera-end top. CAD model only. -->
  <link name="cad_mecheye_camera_link">
    <visual><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_camera.stl" scale="0.001 0.001 0.001"/></geometry><material name="camera_direct_mount_blue"><color rgba="0.27 0.49 0.60 1"/></material></visual>
    <collision><geometry><mesh filename="package://fusion_model_ros2_beta/meshes/end_effector/end_effector_camera.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="tool0-cad_mecheye_camera" type="fixed">
    <origin xyz="-0.080221162 0.327612370 0.238737610" rpy="-1.570796327 0 -1.570796327"/>
    <parent link="tool0"/><child link="cad_mecheye_camera_link"/>
  </joint>
  <!-- HISTORICAL 2026-09-21 optical transform, invalid for the changed mount.
       Retained under a legacy frame name; new optical calibration is NOT provided. -->
  <link name="mecheye_camera_optical_frame_legacy_20260921"/>
  <joint name="tool0-mecheye_camera_optical_legacy_20260921" type="fixed">
    <origin xyz="0.0484942352 0.2520224071 0.1993161073" rpy="-1.1547020625 -0.0002532205 -3.1353642945"/>
    <parent link="tool0"/><child link="mecheye_camera_optical_frame_legacy_20260921"/>
  </joint>
  <!-- Rigid 60 mm handle + 48 mm brush tip held at the measured grasp centre. -->
  <link name="brush_link">
    <visual name="brush_handle">
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.060"/>
      </geometry>
      <material name="brush_wood">
        <color rgba="0.42 0.18 0.06 1"/>
      </material>
    </visual>
    <visual name="brush_tip">
      <origin xyz="0 0 0.084" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.048"/>
      </geometry>
      <material name="brush_hair">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>
  </link>
  <joint name="tool0-brush" type="fixed">
    <!-- Manually measured closed-jaw grasp centre in the real-robot repository. -->
    <origin xyz="0 0 0.220" rpy="0 0 0"/>
    <parent link="tool0"/>
    <child link="brush_link"/>
  </joint>

  <!-- Writing surface used by brush_trajectory_driver defaults. -->
  <link name="writing_table_link">
    <visual>
      <geometry>
        <!-- Beta table is the same 800 x 400 mm size as the paper. -->
          <box size="0.80 0.40 0.04"/>
      </geometry>
      <material name="table_gray">
        <color rgba="0.32 0.34 0.36 1"/>
      </material>
    </visual>
  </link>
  <joint name="base-writing_table" type="fixed">
      <!-- Scene coordinates use the real controller base frame. -->
      <origin xyz="0 -0.65 -0.021" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="writing_table_link"/>
  </joint>
  <link name="paper_link">
    <visual>
      <geometry>
        <!-- Beta paper: 800 mm x 400 mm, fully supported by the table. -->
        <box size="0.80 0.40 0.002"/>
      </geometry>
      <material name="paper_white">
        <color rgba="0.96 0.94 0.86 1"/>
      </material>
    </visual>
  </link>
  <joint name="base-paper" type="fixed">
      <origin xyz="0 -0.65 0" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="paper_link"/>
  </joint>
</robot>
